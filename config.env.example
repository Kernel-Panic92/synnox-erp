# SynnoxERP configuration — Copiar a config.env y ajustar

MODE=test                    # test | prod

# Ports
LAUNCHER_PORT=3002
NOMINA_PORT=3000
PROVEEDORES_PORT=3100

# Install path (detectado automáticamente del directorio del repo)
# INSTALL_DIR se establece automáticamente al ejecutar install.sh

# Token interno para comunicación entre módulos (obligatorio en producción)
# Generar con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
INTERNAL_API_TOKEN=

# Variables de entorno — Nómina
# Copia este archivo como .env y configura los valores

# Puerto del servidor (opcional, default: 3000)
PORT=3000

# Entorno: production | development (opcional)
# En production: cookies Secure=true, HSTS activo, exige HE_SECRET
# NODE_ENV=production

# Forzar redirección HTTP → HTTPS (requiere Nginx/apache como proxy)
# ENFORCE_HTTPS=true

# Nombre de la aplicación (se muestra en emails)
APP_NAME=SynnoxERP

# URL base del sistema (usada en emails de notificación y reset de password)
# Ejemplo: https://nomina.miempresa.com
BASE_URL=http://localhost:3000

# Clave AES para cifrar SMTP password (OBLIGATORIA en producción)
# Genera con: openssl rand -hex 32
HE_SECRET=

# Orígenes permitidos para CORS (separados por coma)
# Vacío = permitir todos (solo para desarrollo)
# Ejemplo: https://nomina.miempresa.com,https://admin.miempresa.com
CORS_ORIGIN=

# Email y contraseña del admin por defecto (solo se usa si no hay usuarios)
# AMBOS son requeridos para el primer inicio
ADMIN_EMAIL=
ADMIN_PASS=

# Ruta de la base de datos (opcional)
# DB_PATH=horas_extra.db
